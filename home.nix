{ config, pkgs, lib, inputs, host, ... }:
let
  # Config files are linked to the checkout rather than copied into the
  # store, so edits take effect without a rebuild.
  link = path: config.lib.file.mkOutOfStoreSymlink "${host.dotfilesDir}/${path}";
  emacsLink = path: link ".emacs.d/${path}";

  # Prebuilt grammars for the languages init.el asks treesit-auto for, so
  # Emacs doesn't offer to clone and compile them on first start.
  treesit-grammars = pkgs.emacsPackages.treesit-grammars.with-grammars (g: [
    g.tree-sitter-go
    g.tree-sitter-gomod
    g.tree-sitter-javascript
    g.tree-sitter-nix
    g.tree-sitter-templ
  ]);

  # Playwright MCP, given the secrets this machine provides (see
  # playwright-secrets-dotenv in home-darwin.nix). Playwright types a secret's
  # value wherever the agent types its name, and shows the name in place of
  # the value in what it reports back. That masking only matches the exact
  # value: if a page echoes it back escaped (a password containing " or \
  # read through JSON), the agent sees it. Playwright calls this a
  # convenience, not a security boundary. The dotenv file it loads at
  # startup is removed shortly after.
  playwright-mcp-agent = pkgs.writeShellScriptBin "playwright-mcp-agent" ''
    secrets=/etc/profiles/per-user/$USER/bin/playwright-secrets-dotenv
    if [ -x "$secrets" ]; then
      file=$(mktemp "''${TMPDIR:-/tmp}/playwright-secrets.XXXXXX")
      chmod 600 "$file"
      "$secrets" > "$file"
      (sleep 30; rm -f "$file") >/dev/null 2>&1 &
      exec ${pkgs.playwright-mcp}/bin/playwright-mcp --secrets "$file" "$@"
    fi
    exec ${pkgs.playwright-mcp}/bin/playwright-mcp "$@"
  '';

  # Claude Code profiles. Each subscription login belongs to a config
  # directory (Claude Code keys its Keychain item by CLAUDE_CONFIG_DIR), so
  # two accounts can be signed in at once:
  #   claude           ~/.claude, the default; the work account
  #   claude-personal  ~/.claude-personal; the personal account
  #   claude-bedrock   ~/.claude, billed to Bedrock (home-darwin.nix)
  # Plain `claude` is not wrapped, so anything that runs it without asking
  # (editors, scripts) gets the work account.
  claudePersonalDir = "${config.home.homeDirectory}/.claude-personal";

  claude-personal = pkgs.writeShellScriptBin "claude-personal" ''
    export CLAUDE_CONFIG_DIR=${claudePersonalDir}
    exec ${pkgs.claude-code}/bin/claude "$@"
  '';

  # Emacs is not always started from a shell (on macOS, the Dock), so the
  # agent binaries are referenced by store path rather than found on PATH.
  agent-backends-el = pkgs.writeText "agent-backends.el" ''
    ;;; agent-backends.el --- agent-shell backends (generated by nix) -*- lexical-binding: t; -*-

    (with-eval-after-load 'agent-shell
      (setq agent-shell-anthropic-claude-acp-command
            '("${pkgs.claude-agent-acp}/bin/claude-agent-acp")
            agent-shell-openai-codex-acp-command
            '("${pkgs.codex-acp}/bin/codex-acp")))

    ;; Bedrock needs somewhere to keep the API key, which is platform-specific,
    ;; so its part is only generated where one is set up.  It defines
    ;; `agent-backends--bedrock-environment'.
    (load (expand-file-name "lisp/agent-backends-bedrock" user-emacs-directory)
          :noerror)

    (defvar agent-shell-anthropic-claude-environment)

    (defconst agent-backends-claude-profiles '("work" "personal" "bedrock")
      "Claude profiles, as for the claude, claude-personal and claude-bedrock commands.")

    (defun agent-backends--environment (profile)
      "Return the agent-shell Claude environment for PROFILE.
    PROFILE is the symbol `work' (~/.claude, the default), `personal'
    (~/.claude-personal) or `bedrock'."
      (require 'agent-shell)
      (pcase profile
        ('work nil)
        ('personal
         (agent-shell-make-environment-variables
          "CLAUDE_CONFIG_DIR" "${claudePersonalDir}"
          :inherit-env t))
        ('bedrock
         (if (fboundp 'agent-backends--bedrock-environment)
             (agent-backends--bedrock-environment)
           (user-error "Bedrock is not set up on this machine")))
        (_ (user-error "Unknown Claude profile: %s" profile))))

    (defun agent-backends-claude (profile)
      "Make new agent-shell Claude sessions use PROFILE by default.
    PROFILE is the symbol `work', `personal' or `bedrock'.  Sessions started
    with `agent-shell-claude-work', `agent-shell-claude-personal' or
    `agent-shell-claude-bedrock' ignore this."
      (interactive
       (list (intern (completing-read "Claude profile: "
                                      agent-backends-claude-profiles nil t))))
      (setq agent-shell-anthropic-claude-environment
            (agent-backends--environment profile))
      (message "agent-shell Claude profile: %s" profile))

    (defun agent-backends--start (profile name)
      "Start a Claude session with PROFILE, in a buffer named after NAME."
      (require 'agent-shell)
      (let ((environment (agent-backends--environment profile))
            (config (copy-alist (agent-shell-anthropic-make-claude-code-config))))
        (setf (alist-get :buffer-name config) name
              (alist-get :mode-line-name config) name
              (alist-get :client-maker config)
              (lambda (buffer)
                (let ((agent-shell-anthropic-claude-environment environment))
                  (agent-shell-anthropic-make-claude-client :buffer buffer))))
        (agent-shell-start :config config)))

    (defun agent-shell-claude-work ()
      "Start a Claude session on the work account, whatever the default is."
      (interactive)
      (agent-backends--start 'work "Claude Work"))

    (defun agent-shell-claude-personal ()
      "Start a Claude session on the personal account, whatever the default is."
      (interactive)
      (agent-backends--start 'personal "Claude Personal"))

    (defun agent-shell-claude-bedrock ()
      "Start a Claude session that uses Bedrock, whatever the default is."
      (interactive)
      (agent-backends--start 'bedrock "Claude Bedrock"))

    (provide 'agent-backends)
    ;;; agent-backends.el ends here
  '';
in
{
  home.stateVersion = "26.05";

  home.packages = [
    pkgs.gh
    pkgs.awscli2
    pkgs.gawk
    pkgs.ripgrep
    pkgs.nixpkgs-fmt
    # Plain TCP port forwarding, e.g. a local port to a database on a VPN.
    pkgs.socat
    pkgs.tmux
    # Markdown rendering for crafted-writing-config.
    pkgs.pandoc
    # Go tooling used by ftlio-golang-config.el (eglot, flycheck, templ).
    pkgs.go
    pkgs.gopls
    pkgs.golangci-lint
    pkgs.templ
    # `jira`. Reads its API token from the system keyring (on macOS, the
    # Keychain; see jira-set-token), so it works from scripts and agents too.
    pkgs.jira-cli-go
    # `databricks`: Databricks CLI (bundles, auth, SQL via the statement API).
    pkgs.databricks-cli
    # Reading .xlsx files (e.g. the security risk register) from scripts.
    (pkgs.python3.withPackages (ps: [ ps.openpyxl ]))
    # Browser automation for agents, through MCP. Opens a visible Chromium
    # with a fresh in-memory profile; registered with Claude and Codex below.
    playwright-mcp-agent
    pkgs.claude-code
    claude-personal
    pkgs.codex
    pkgs.claude-agent-acp
    pkgs.codex-acp
  ];

  # Loaded by ftlio-ai-config.el.
  home.file.".emacs.d/lisp/agent-backends.el".source = agent-backends-el;
  # Per-machine Emacs settings from the host description; loaded by init.el.
  home.file.".emacs.d/lisp/host-local.el".text = ''
    ;;; host-local.el --- per-machine settings (generated by nix) -*- lexical-binding: t; -*-

    ${host.emacsExtra}
    ;;; host-local.el ends here
  '';

  home.file.".emacs.d/early-init.el".source = emacsLink "early-init.el";
  home.file.".emacs.d/init.el".source = emacsLink "init.el";
  home.file.".emacs.d/ftlio".source = emacsLink "ftlio";
  home.file.".emacs.d/other-packages".source = emacsLink "other-packages";
  home.file.".config/crafted-emacs".source = inputs.crafted-emacs;
  # Linked file by file, so grammars Emacs installs itself can sit alongside.
  home.file.".emacs.d/tree-sitter" = {
    source = "${treesit-grammars}/lib";
    recursive = true;
  };

  home.file.".tmux.conf".source = link ".tmux.conf";

  # AWS CLI profiles and SSO sessions, from the host description. Managed
  # only when given; `aws sso login` keeps its tokens in ~/.aws/sso, so a
  # read-only config is fine, but `aws configure` can no longer edit it.
  home.file.".aws/config" = lib.mkIf (host.awsConfig != "") {
    text = host.awsConfig;
  };

  # One set of machine-wide instructions for both coding agents.
  home.file.".claude/CLAUDE.md".source = link "agents/global-instructions.md";
  home.file.".claude-personal/CLAUDE.md".source = link "agents/global-instructions.md";
  home.file.".codex/AGENTS.md".source = link "agents/global-instructions.md";

  # .bashrc is plain bash; nix only puts what it sources where it looks.
  # It picks up a platform file (.bashrc.darwin, from home-darwin.nix) itself.
  home.file.".bashrc".source = link ".bashrc";
  home.file.".bash_profile".source = link ".bash_profile";
  home.file.".oh-my-bash".source = inputs.oh-my-bash;
  home.file.".local/share/blesh".source = "${pkgs.blesh}/share/blesh";

  programs.git = {
    enable = true;
    ignores = [
      # Emacs
      "*~"
      "\\#*\\#"
      "/.emacs.desktop"
      "/.emacs.desktop.lock"
      ".tern-*"
      ".\\#*"
      ".projectile"
      # OS Files
      ".DS_Store"
      ".DS_Store?"
      ".Spotlight-V100"
      ".Trashes"
      ".ehthumbs.db"
      "Thumbs.db"
      # Coding agents: instructions, local settings and scratch state.
      # Ignored everywhere by default; a repo that shares them tracks them
      # with `git add -f`, after which this no longer applies to them.
      # .claude/ itself is left trackable, as Claude Code intends: shared
      # settings, skills and agents go in the repo, personal settings don't.
      "CLAUDE.md"
      "CLAUDE.local.md"
      ".claude/settings.local.json"
      "AGENTS.md"
      "AGENTS.override.md"
      ".codex/"
      # Page snapshots and screenshots Playwright MCP saves in the working
      # directory.
      ".playwright-mcp/"
    ];
    settings = {
      user = {
        inherit (host.git) name email;
      } // lib.optionalAttrs (host.git.signingKey != null) {
        inherit (host.git) signingKey;
      };
      commit.gpgSign = host.git.signingKey != null;
      tag.gpgSign = host.git.signingKey != null;
      core.editor = "emacs";
      url."git@github.com:".insteadOf = [ "https://github.com" "https://github.com/" ];
    };
    # Other identities, each applying to the repos under one directory.
    includes = map
      (identity: {
        condition = "gitdir:${identity.gitdir}";
        contents.user = removeAttrs identity [ "gitdir" ];
      })
      host.git.identities;
  };

  programs.gpg.enable = true;

  # The shell hook is in .bashrc.
  programs.direnv = {
    enable = true;
    nix-direnv.enable = true;
    # Drop the "direnv: export +AR +AS ..." line printed on every load.
    config.global.hide_env_diff = true;
  };

  # Two keys: github_ftlio for GitHub only, id_ed25519 for everything else
  # (servers, other machines). IdentitiesOnly keeps ssh from offering a host
  # every key in the agent.
  #
  # On macOS, key passphrases come from the login Keychain. Store each once
  # with:
  #   ssh-add --apple-use-keychain ~/.ssh/<key>
  # UseKeychain is an Apple extension; IgnoreUnknown lets any other ssh skip
  # it.
  home.file.".ssh/config".text = ''
    ${host.sshConfig}
    Host github.com
      IdentityFile ~/.ssh/github_ftlio

    Host *
      IgnoreUnknown UseKeychain
      UseKeychain yes
      AddKeysToAgent yes
      IdentitiesOnly yes
      IdentityFile ~/.ssh/id_ed25519
  '';

  # Register MCP servers with Claude Code and Codex. Both keep their server
  # lists in files they also write to themselves (~/.claude.json,
  # ~/.codex/config.toml), so they are added through each CLI rather than by
  # managing those files: only when missing, or when registered with a
  # different command. The command is the stable profile path, so the
  # registration outlives rebuilds.
  #
  # Claude Code is registered once per profile. The default profile is
  # reached with CLAUDE_CONFIG_DIR unset, not set to ~/.claude: setting it
  # moves ~/.claude.json and the Keychain item, and would look like a
  # different, signed-out profile.
  home.activation.registerMcpServers = lib.hm.dag.entryAfter [ "writeBoundary" ] ''
    playwright=/etc/profiles/per-user/${config.home.username}/bin/playwright-mcp-agent
    claude=${pkgs.claude-code}/bin/claude
    codex=${pkgs.codex}/bin/codex
    for profile in default personal; do
      if [ $profile = default ]; then
        profileClaude=(env -u CLAUDE_CONFIG_DIR "$claude")
      else
        profileClaude=(env CLAUDE_CONFIG_DIR=${claudePersonalDir} "$claude")
      fi
      if ! "''${profileClaude[@]}" mcp get playwright 2>/dev/null | grep -qF "$playwright"; then
        "''${profileClaude[@]}" mcp remove --scope user playwright >/dev/null 2>&1 || true
        run "''${profileClaude[@]}" mcp add --scope user playwright -- "$playwright" ||
          echo "warning: could not register playwright with Claude Code ($profile profile)" >&2
      fi
    done
    if ! "$codex" mcp get playwright 2>/dev/null | grep -qF "$playwright"; then
      "$codex" mcp remove playwright >/dev/null 2>&1 || true
      run "$codex" mcp add playwright -- "$playwright" ||
        echo "warning: could not register playwright with Codex" >&2
    fi
  '';
}
