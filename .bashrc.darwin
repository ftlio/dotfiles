#!/usr/bin/env bash
#
# macOS-only settings, sourced by .bashrc on Darwin.  Like .bashrc it is in
# two halves: environment first, then interactive-only behind a guard.

# ---------------------------------------------------------------------------
# 1. Environment -- every shell
# ---------------------------------------------------------------------------

# Homebrew
export PATH="/opt/homebrew/bin:$PATH"

# Docker runs in a colima VM.  The docker CLI finds it through its own
# context; this is for tools that only look at DOCKER_HOST or the default
# socket (testcontainers, SDKs).
if command -v colima >/dev/null; then
  export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"
fi

# ---------------------------------------------------------------------------
# 2. Interactive only
# ---------------------------------------------------------------------------

case $- in
  *i*) ;;
    *) return;;
esac

# The system awk is the BSD one; prefer GNU awk, as on Linux.
command -v gawk >/dev/null && alias awk="gawk"
